    <param name="~mode" type="string" value="debug" />
    <param name="~fixed_frame" value="sensor_init" type="string" />
    <param name="~base_frame" value="vehicle" type="string" /> -->

    <!-- hindo of learning -->
    <!-- <param name="~learning_thread_rate" type="double" value="5.0" /> -->
    
    <!-- <remap from="/wild_visual_navigation_node/robot_state" to="/wvn_robot_state_converted"/>
    <remap from="/wild_visual_navigation_node/desired_twist" to="/cmd"/> -->

  </node> 

  <node name="wvn_feature_extractor_node" pkg="wild_visual_navigation_ros" type="wvn_feature_extractor_node.py" output="screen">
    <param name="~reload_default_params" value="False" />
    
    <!-- <param name="~pretrained_weights" value="/path/to/your/checkpoint.pt" type="string" /> 
    <param name="~checkpoint_key" value="student" type="string" /> 
    <param name="~dino_backbone" value="vit_small" type="string" /> 
