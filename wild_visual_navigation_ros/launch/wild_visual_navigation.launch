    <param name="~camera_topics/rear/publish_input_image" value="True" type="bool" />
    <param name="~camera_topics/rear/scheduler_weight" value="100" type="int" />
    
    <param name="~network_input_image_height" value="224" type="int" />
    <param name="~network_input_image_width" value="224" type="int" />
    
    <param name="~segmentation_type" value="slic" type="string" />
    <param name="~feature_type" value="dino" type="string" />
    <param name="~dino_patch_size" value="8" type="int" />
    <param name="~dino_backbone" value="vit_small" type="string" />
    <param name="~slic_num_components" value="200" type="int" />
    
    <param name="~confidence_std_factor" value="1.0" type="double" />
    <param name="~prediction_per_pixel" value="False" type="bool" />
    <param name="~mode" value="debug" type="string" />
    <param name="~status_thread_rate" value="1.0" type="double" />
    <param name="~device" value="cuda" type="string" />
    <param name="~log_confidence" value="True" type="bool" />
    <param name="~verbose" value="True" type="bool" />
    <param name="~image_callback_rate" value="5.0" type="double" />
    <param name="~load_save_checkpoint_rate" value="1.0" type="double" /> -->

