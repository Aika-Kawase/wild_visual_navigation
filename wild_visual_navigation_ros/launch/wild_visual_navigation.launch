<launch>

  <!-- <param name="use_sim_time" value="true"/> -->


  <!-- Arguments -->
  <arg name="camera_file"       default="$(find wild_visual_navigation_ros)/config/wild_visual_navigation/resized_wide_angle_dual.yaml"/>
  <arg name="params_file"       default="$(find wild_visual_navigation_ros)/config/wild_visual_navigation/default.yaml"/>
  <arg name="overlay_images"    default="True"/>

  <!-- Clear old params -->
  <rosparam command="delete" param="wvn_learning_node"/>
  <rosparam command="delete" param="wvn_feature_extractor_node"/>

  <!-- Load parameters -->
  <rosparam command="load" file="$(arg params_file)" ns="wvn_learning_node"/>
  <rosparam command="load" file="$(arg camera_file)" ns="wvn_learning_node"/>
  <rosparam command="load" file="$(arg params_file)" ns="wvn_feature_extractor_node"/>
  <rosparam command="load" file="$(arg camera_file)" ns="wvn_feature_extractor_node"/>

  <rosparam file="$(find wild_visual_navigation_ros)/config/wild_visual_navigation/robot_params.yaml" 
            command="load" 
            ns="/wvn_state_publisher/robot_params" />

  <!-- tartan camera_info -->
  <node name="camera_info_publisher" pkg="wild_visual_navigation_ros" type="camera_info_publisher.py" output="screen" />

  <!-- for odom/etc -> RobotState -->
  <!-- <node name="wvn_state_publisher" pkg="wild_visual_navigation_ros" type="wvn_state_publisher.py" output="screen">
  </node> -->

  <!-- tartan tf -->
  <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="camera_tf" 
        args="0.4 0.0 0.7 0.0 0.0 0.0 vehicle multisense/head" /> -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="left_camera_tf" 
        args="0.0 -0.105 0.0 0 -0.1 0 multisense/head multisense/left_camera_optical_frame" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="right_camera_tf" 
        args="0.0 0.105 0.0 0 -0.1 0 multisense/head multisense/right_camera_optical_frame" /> 
  <node pkg="tf2_ros" type="static_transform_publisher" name="vehicle_footprint_tf" 
        args="0.0 -332 0.0 0 0 0 vehicle vehicle_footprint" />

  <!-- whill tf -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="use_cam_tf" 
        args="0.0 0.0 0.0 0 0 0 realsense_link use_cam" />

  <!-- Launch node -->
  <node name="wvn_learning_node" pkg="wild_visual_navigation_ros" type="wvn_learning_node.py" output="screen">
    <param name="reload_default_params" value="False" />
      <!-- <rosparam>
        imu_topic: "/multisense/imu/imu_data"
        imu2_topic: "/novatel/imu/data"
        odom_topic: "/odom"
        cmd_topic: "/cmd_vel"
      </rosparam> -->

    <!-- <param name="~robot_state_topic" value="/wvn_robot_state_converted" type="string" /> -->

    <!-- tartan -->
    <!-- <param name="~desired_twist_topic" value="/cmd" type="string" /> -->

    <!-- jackal -->
    <!-- <param name="~desired_twist_topic" value="/cmd_vel" type="string" /> -->
    
    <!-- tartan -->
    <!-- <param name="~fixed_frame" value="sensor_init" type="string" />
    <param name="~base_frame" value="vehicle" type="string" />
    <param name="~footprint_frame" value="vehicle" type="string" /> -->

    <!-- jackal -->
    <!-- <param name="~fixed_frame" value="odom" type="string" />
    <param name="~base_frame" value="base_link" type="string" />
    <param name="~footprint_frame" value="base_link" type="string" />

    <param name="~robot_length" value="0.8" type="double" />
    <param name="~robot_width" value="0.3" type="double" />
    <param name="~robot_height" value="0.3" type="double" />

    <param name="~traversability_radius" value="3.0" type="double" />
    <param name="~image_graph_dist_thr" value="0.2" type="double" />
    <param name="~supervision_graph_dist_thr" value="0.1" type="double" />
    <param name="~network_input_image_height" value="224" type="int" />
    <param name="~network_input_image_width" value="224" type="int" />
    <param name="~segmentation_type" value="stego" type="string" />
    <param name="~feature_type" value="stego" type="string" />
    <param name="~dino_patch_size" value="8" type="int" />
    <param name="~dino_backbone" value="vit_small" type="string" />
    <param name="~slic_num_components" value="100" type="int" />
    <param name="~confidence_std_factor" value="1.0" type="double" />
    <param name="~min_samples_for_training" value="1" type="int" />
    <param name="~prediction_per_pixel" value="True" type="bool" />
    <param name="~vis_node_index" value="10" type="int" />
    
    <param name="~untraversable_thr" value="0.0" type="double" />
    <param name="~mission_name" value="test" type="string" />
    <param name="~mission_timestamp" value="True" type="bool" />

    <param name="~image_callback_rate" value="5.0" type="double" /> -->
    <!-- before 30 -->
    <!-- <param name="~supervision_callback_rate" value="10" type="double" />
    <param name="~learning_thread_rate" value="10" type="double" />
    <param name="~logging_thread_rate" value="2" type="double" />
    <param name="~status_thread_rate" value="0.5" type="double" />
