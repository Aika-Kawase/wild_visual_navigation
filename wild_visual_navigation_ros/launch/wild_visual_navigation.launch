    <!-- from 1.0 -->

    <!-- <param name="~device" value="cuda" type="string" />
    <param name="~mode" value="online" type="string" />
    <param name="~colormap" value="RdYlBu" type="string" />

    <param name="~print_image_callback_time" value="False" type="bool" />
    <param name="~print_supervision_callback_time" value="False" type="bool" />
    <param name="~log_time" value="False" type="bool" />
    <param name="~log_confidence" value="False" type="bool" />
    <param name="~verbose" value="True" type="bool" />
    <param name="~extraction_store_folder" value="nan" type="string" /> -->
    

    <!-- tartan -->
    <!-- <param name="~camera_topics/front/image_topic" value="/multisense/left/image_rect_color" type="string" />
    <param name="~camera_topics/front/info_topic" value="/multisense/left/camera_info" type="string" /> -->

    <!-- jackal -->
    <!-- <param name="~camera_topics/front/image_topic" value="/depth_camera/color/image_raw" type="string" />
    <param name="~camera_topics/front/info_topic" value="/depth_camera/color/camera_info" type="string" />

    <param name="~camera_topics/front/use_for_training" value="True" type="bool" />
    <param name="~camera_topics/front/publish_confidence" value="True" type="bool" />
    <param name="~camera_topics/front/publish_input_image" value="True" type="bool" />
